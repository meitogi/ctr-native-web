# ctr-relay behind your reverse proxy — copy to .env and fill in.
# Every compose file of this kit reads this one file : docker compose --env-file ../.env …

# Host name the relay answers on. Its DNS A/AAAA record points at your proxy.
# DNS only : a CDN proxy in front (Cloudflare orange cloud) cuts idle WebSockets.
RELAY_DOMAIN=relay.example.org

# Access key, sent by players in the room link (rk=…). Empty = open relay.
# Generate one : openssl rand -base64 24
RELAY_KEY=

# Docker network your proxy container is attached to (created by your proxy's setup).
PROXY_NETWORK=proxy

# Traefik only : entry point and certificate resolver names from your static config.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
